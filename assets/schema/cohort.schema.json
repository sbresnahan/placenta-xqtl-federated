{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sbresnahan/placenta-xqtl-federated/assets/schema/cohort.schema.json",
  "title": "placenta-xqtl-federated cohort parameters (cohort.yml)",
  "description": "Passed to Nextflow with -params-file cohort.yml. Every key is documented in docs/CONFIGURATION.md.",
  "type": "object",
  "required": [
    "cohort_id"
  ],
  "properties": {
    "cohort_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,31}$",
      "description": "Short cohort label used in file names and exports (letters, digits, _ or -)."
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "prepare_references",
        "imputation_prep",
        "site",
        "phenotyping_only",
        "export",
        "central",
        "smoke",
        null
      ]
    },
    "outdir": {
      "type": "string",
      "description": "Output directory on a filesystem visible to compute nodes."
    },
    "release": {
      "type": [
        "string",
        "null"
      ],
      "description": "Export release tag; default <cohort_id>_<yyyymmdd>."
    },
    "samplesheet": {
      "type": [
        "string",
        "null"
      ],
      "description": "CSV with sample_id,fastq_1,fastq_2 (fastq_2 empty for single-end)."
    },
    "metadata": {
      "type": [
        "string",
        "null"
      ],
      "description": "TSV with rnaseq_id, genotype_id, sex, GA and optional exposures."
    },
    "restricted": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path to xqtl-restricted-<version>.tar.gz (request by email if missing)."
    },
    "site_refs": {
      "type": [
        "string",
        "null"
      ],
      "description": "Directory written by --mode prepare_references."
    },
    "phenotypes_dir": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Directory of ready phenotype inputs (<modality>.bed.gz with gene-TSS coordinates, expression.counts.bed.gz, qc_metrics.tsv, cell_proportions.tsv). When set, --mode site maps these instead of running the phenotyping workflow (site_refs is then not required)."
    },
    "image_sha256": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "sha256 of the pipeline image; set by run_xqtl.sh and recorded in the export manifest."
    },
    "genotypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pre-imputation genotypes: VCF/BCF (bgzipped) or PLINK prefix (.bed/.bim/.fam or .pgen/.pvar/.psam)."
        },
        "raw_build": {
          "type": "string",
          "enum": [
            "GRCh37",
            "GRCh38"
          ],
          "default": "GRCh38"
        },
        "source": {
          "type": "string",
          "enum": [
            "array",
            "wes",
            "wgs"
          ],
          "default": "array"
        },
        "imputed_dir": {
          "type": [
            "string",
            "null"
          ],
          "description": "Directory holding TOPMed output chr*.dose.vcf.gz (decrypted)."
        },
        "imputed_pattern": {
          "type": "string",
          "default": "chr{chr}.dose.vcf.gz"
        }
      }
    },
    "imputation_prep": {
      "type": "object",
      "additionalProperties": false,
      "description": "--mode imputation_prep filters (atlas filter_vcf_for_imputation).",
      "properties": {
        "geno_missing_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05,
          "description": "Exclude variants with F_MISSING above this."
        },
        "maf_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.01,
          "description": "Exclude variants with MAF below this."
        },
        "hwe_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1e-06,
          "description": "Exclude variants with HWE exact-test p below this."
        },
        "sample_missing_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05,
          "description": "Flag samples with autosomal missingness above this (not removed)."
        },
        "ref_match_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.95,
          "description": "Stop when fewer SNPs than this match GRCh38 (wrong build or strand)."
        }
      }
    },
    "rnaseq": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_layout": {
          "type": "string",
          "enum": [
            "paired",
            "single"
          ],
          "default": "paired"
        },
        "strandedness": {
          "type": "string",
          "enum": [
            "reverse",
            "forward",
            "unstranded"
          ],
          "default": "reverse"
        },
        "read_length": {
          "type": "integer",
          "minimum": 30,
          "maximum": 500,
          "default": 150
        },
        "library_type": {
          "type": "string",
          "enum": [
            "total",
            "polyA",
            "3prime"
          ],
          "default": "total",
          "description": "3prime libraries disable isoform, splicing, transcript-end and editing modalities."
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rsq_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.4
        },
        "maf_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.01
        },
        "mac_min": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "hwe_p_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1e-06
        },
        "geno_missing_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05
        },
        "sample_missing_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05
        }
      }
    },
    "ancestry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_n": {
          "type": "integer",
          "minimum": 50,
          "default": 50,
          "description": "Ancestry groups with fewer analysed samples are not mapped or exported (floor 50)."
        },
        "assign_prob_min": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1,
          "default": 0.8
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AFR",
              "AMR",
              "EAS",
              "EUR",
              "SAS"
            ]
          },
          "default": [
            "AFR",
            "AMR",
            "EAS",
            "EUR",
            "SAS"
          ]
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cis_window": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 5000000,
          "default": 1000000
        },
        "fdr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "default": 0.05
        },
        "hcp_grid": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": null,
          "description": "null = automatic: 0..60 by 10 for n < 350, else 0..100 by 10."
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "expression",
              "isoform_expression",
              "isoform_usage",
              "splicing",
              "intron_retention",
              "alt_tss",
              "alt_polya",
              "rna_editing",
              "stability"
            ]
          },
          "default": [
            "expression",
            "isoform_expression",
            "isoform_usage",
            "splicing",
            "intron_retention",
            "alt_tss",
            "alt_polya",
            "rna_editing",
            "stability"
          ]
        },
        "seed": {
          "type": "integer",
          "default": 20261029
        },
        "nperm": {
          "type": "integer",
          "minimum": 100,
          "default": 10000,
          "description": "tensorQTL permutations (atlas: 10000)."
        },
        "hcp_max_phenotypes": {
          "type": "integer",
          "minimum": 1000,
          "default": 20000,
          "description": "phenotypes sampled (seeded) to fit HCP factors."
        },
        "eval_chrom": {
          "type": "string",
          "default": "chr1",
          "description": "chromosome used to count eGenes for k selection (atlas: chr1)."
        },
        "eval_min_phenotypes": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "if eval_chrom has fewer phenotypes, k is selected genome-wide."
        },
        "independent_chunk_size": {
          "type": "integer",
          "minimum": 1,
          "default": 100,
          "description": "significant phenotypes/groups per conditional-analysis task."
        }
      }
    },
    "ld": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maf_min": {
          "type": "number",
          "default": 0.05
        },
        "rsq_min": {
          "type": "number",
          "default": 0.8
        },
        "window_mb": {
          "type": "number",
          "default": 3
        },
        "step_mb": {
          "type": "number",
          "default": 1
        }
      }
    },
    "gxc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "exclude_cell_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Maternal"
          ],
          "description": "Cell types never used as G x C targets (atlas: the maternal decidual fraction)."
        },
        "fdr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.05,
          "description": "BH q threshold for a primary cell type (per stratum x modality)."
        },
        "min_n": {
          "type": "integer",
          "minimum": 10,
          "default": 20,
          "description": "Minimum complete samples for one pair x cell-type fit (atlas 49)."
        },
        "maternal_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Maternal-contamination sensitivity refit drops samples above this maternal proportion."
        }
      }
    },
    "gxe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maf_interaction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.05
        },
        "min_n": {
          "type": "integer",
          "minimum": 50,
          "default": 50
        },
        "min_cases": {
          "type": "integer",
          "minimum": 10,
          "default": 20,
          "description": "Binary exposures need at least this many cases and controls in a group."
        },
        "exposures": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "column": {
                "type": "string",
                "description": "Metadata column; defaults to the exposure name."
              },
              "type": {
                "type": "string",
                "enum": [
                  "continuous",
                  "binary"
                ],
                "default": "continuous"
              },
              "transform": {
                "type": "string",
                "enum": [
                  "none",
                  "log",
                  "inverse_normal"
                ],
                "default": "none"
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ],
                "default": null
              }
            }
          },
          "default": {
            "GA": {
              "enabled": true,
              "column": "GA",
              "type": "continuous",
              "transform": "none",
              "min": 20,
              "max": 45
            },
            "ppBMI": {
              "enabled": false,
              "column": "ppBMI",
              "type": "continuous",
              "transform": "none",
              "min": 14,
              "max": 70
            },
            "gdm": {
              "enabled": false,
              "column": "gdm",
              "type": "binary",
              "transform": "none",
              "min": 0,
              "max": 1
            },
            "ogtt": {
              "enabled": false,
              "column": "ogtt",
              "type": "continuous",
              "transform": "none",
              "min": null,
              "max": null
            }
          }
        },
        "sensitivity": {
          "type": "object",
          "description": "SNP x covariate sensitivity of tier-1 hits (atlas 55). Off unless a covariate is enabled; ancestry_pcs uses the PC rows of the mapping covariates.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "column": {
                "type": "string",
                "description": "Metadata column; defaults to the covariate name (not used by ancestry_pcs)."
              }
            }
          },
          "default": {
            "maternal_age": {
              "enabled": false,
              "column": "maternal_age"
            },
            "parity": {
              "enabled": false,
              "column": "parity"
            },
            "smoking": {
              "enabled": false,
              "column": "smoking"
            },
            "GA": {
              "enabled": false,
              "column": "GA"
            },
            "ancestry_pcs": {
              "enabled": false
            }
          }
        },
        "tier1_permutation_blocks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "default": [
            100,
            400,
            500,
            9000
          ],
          "description": "Adaptive phenotype-permutation blocks for tier 1 (cumulative 100/500/1000/10000); a block runs only while the running empirical p <= 0.10."
        },
        "dosages": {
          "type": "boolean",
          "default": false,
          "description": "Use imputed dosages instead of hard calls (the atlas used hard calls)."
        },
        "tier2": {
          "type": "string",
          "enum": [
            "all_cis_union",
            "pairs"
          ],
          "default": "all_cis_union",
          "description": "all_cis_union: every cis variant of every tier-2 phenotype; pairs: only the site-lead and MDACC-lead variants (smaller export)."
        },
        "seed": {
          "type": "integer",
          "default": 12345,
          "description": "Base permutation seed; phenotype i uses seed + its row index."
        },
        "fdr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.05,
          "description": "q threshold for tier-1 hits (sensitivity refits and counts)."
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "parquet",
            "tsv.gz"
          ],
          "default": "parquet"
        },
        "leak_scan": {
          "type": "boolean",
          "const": true,
          "default": true,
          "description": "The sample-identifier scan cannot be disabled."
        },
        "min_mac_export": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "round_digits": {
          "type": [
            "integer",
            "null"
          ],
          "default": null
        }
      }
    },
    "central": {
      "type": "object",
      "additionalProperties": false,
      "description": "--mode central (MDACC): meta-analysis of site exports. See docs/CENTRAL_ANALYSIS.md.",
      "properties": {
        "studies": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "TSV with columns study_id, export_dir (one received export folder per study, the folder holding MANIFEST.tsv). Required for --mode central."
        },
        "gwas_catalog": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional TSV with columns trait_id, path, ancestry, n, trait_type (quantitative|cc), prop_cases. Enables colocalization."
        },
        "annotations": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional TSV with columns name, bed: annotation BED files for PIP enrichment."
        },
        "fdr": {
          "type": "number",
          "default": 0.05,
          "minimum": 0,
          "maximum": 1,
          "description": "Feature-level (Storey q) and interaction (BH) significance threshold."
        },
        "palindromic_maf_max": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 0.5,
          "description": "A/T and C/G variants whose orientation differs between contributions are dropped when MAF exceeds this in any contribution."
        },
        "freq_diff_max": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Flag a contribution's variant as a frequency outlier when |EAF - N-weighted mean EAF of the other contributions of the same ancestry| exceeds this (flag only)."
        },
        "verify_checksums": {
          "type": "boolean",
          "default": true,
          "description": "Verify every exported file against MANIFEST.tsv sha256."
        },
        "gxc_min_contributions": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "G x C pairs with at least this many contributions are meta-analysed by IVW; otherwise the single p-value is carried."
        },
        "pip_threshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "PIP threshold for high-confidence variants in summaries and enrichment."
        },
        "finemap": {
          "type": "object",
          "additionalProperties": false,
          "description": "Multi-ancestry fine-mapping (SuShiE, summary-statistics mode).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "L": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of single effects per locus."
            },
            "min_variants": {
              "type": "integer",
              "default": 50,
              "minimum": 2,
              "description": "Minimum shared variants (with LD in every kept ancestry) per locus."
            },
            "ld_ridge": {
              "type": "number",
              "default": 0.001,
              "minimum": 0,
              "maximum": 1,
              "description": "Minimum diagonal shrinkage added to the N-weighted LD matrix."
            },
            "purity": {
              "type": "number",
              "default": 0.5,
              "minimum": 0,
              "maximum": 1,
              "description": "Minimum absolute correlation within a credible set."
            },
            "max_loci": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "default": null,
              "description": "Fine-map at most this many loci (smallest feature p first); null = all significant."
            },
            "shard_size": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "description": "Loci per fine-mapping task."
            }
          }
        },
        "coloc": {
          "type": "object",
          "additionalProperties": false,
          "description": "xQTL x GWAS colocalization (needs gwas_catalog).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "pp_h4": {
              "type": "number",
              "default": 0.7,
              "minimum": 0,
              "maximum": 1,
              "description": "PP.H4 threshold for calling colocalization."
            },
            "L": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50,
              "description": "SuSiE single effects per trait."
            },
            "min_variants": {
              "type": "integer",
              "default": 50,
              "minimum": 2,
              "description": "Minimum variants shared by the locus and the GWAS."
            },
            "colocboost": {
              "type": "boolean",
              "default": true,
              "description": "Also run ColocBoost."
            },
            "M": {
              "type": "integer",
              "default": 500,
              "minimum": 10,
              "description": "ColocBoost boosting iterations."
            },
            "shard_size": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "description": "Colocalization tasks per job."
            }
          }
        },
        "twas": {
          "type": "object",
          "additionalProperties": false,
          "description": "TWAS input contract (OTTERS / mvOTTERS, FUSION weights).",
          "properties": {
            "features": {
              "type": "string",
              "enum": [
                "significant",
                "all"
              ],
              "default": "significant",
              "description": "Features written to the OTTERS summary-statistics files."
            }
          }
        }
      }
    }
  }
}
