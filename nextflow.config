// placenta-xqtl-federated -- top-level configuration
//
// Combine profiles as  -profile <site or executor>[,<container engine>][,test|smoke]
//   e.g.  -profile seadragon            (LSF + Apptainer/Singularity + seadragon defaults)
//         -profile slurm,apptainer      (generic SLURM site)
//         -profile local,apptainer      (one large node, no scheduler)
//         -profile test,docker          (CI)
// Cohort settings are passed as a params file:  -params-file cohort.yml
// Full documentation: docs/HPC.md and docs/CONFIGURATION.md

manifest {
    name            = 'sbresnahan/placenta-xqtl-federated'
    author          = 'Sean T. Bresnahan (MD Anderson Cancer Center, Bhattacharya Lab)'
    homePage        = 'https://github.com/sbresnahan/placenta-xqtl-federated'
    description     = 'Federated multi-ancestry placental xQTL pipeline: site-local analysis and summary-level export'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0-dev'
    license         = 'GPL-3.0'
}

params {
    // ---- run mode and inputs -------------------------------------------------
    mode                 = null      // prepare_references | imputation_prep | site | phenotyping_only | export | central | smoke
    cohort_id            = null
    outdir               = 'results'
    release              = null      // export release tag; default <cohort_id>_<yyyymmdd>

    // ---- software image and reference data ---------------------------------
    sif                  = null      // path to the .sif (set by run_xqtl.sh); overrides params.image
    image                = 'ghcr.io/sbresnahan/placenta-xqtl-federated:1.0.0-dev'
    refs_dir             = '/opt/xqtl/refs'   // public references embedded in the image
    site_refs            = null      // host directory written by --mode prepare_references (indices)
    phenotypes_dir       = null      // ready phenotype BEDs: --mode site skips phenotyping (docs/EXPORT_SPEC.md)
    image_sha256         = null      // set by run_xqtl.sh; recorded in the export manifest
    restricted           = null      // xqtl-restricted-<version>.tar.gz (request by email if missing)
    expected_restricted_version = '1'

    // ---- scheduler and resources (see docs/HPC.md) --------------------------
    max_cpus             = 16
    max_memory           = '128.GB'
    max_time             = '120.h'
    queue                = null      // force one queue/partition for every task
    queue_rules          = null      // walltime-based selection, e.g. 'short:3h,medium:24h,long:120h'
    gpu_queue            = null
    gpu_cluster_options  = ''        // LSF: '-gpu num=1'  SLURM: '--gres=gpu:1'  PBS: '-l ngpus=1'
    cluster_options      = ''        // extra flags for every job (account/project codes)
    use_gpu              = false     // run tensorQTL steps on GPU (requires the -cuda image)
    bind_paths           = ''        // comma-separated host paths to bind into the container
    lsf_per_job_mem      = true      // LSF: memory requests are per job (LSF_UNIT_FOR_LIMITS-aware)
    queue_size           = 100       // max concurrent jobs submitted by Nextflow
    submit_rate_limit    = '10 sec'
    job_array_size       = 50        // tasks per job array for many-small-task steps; 0 disables arrays

    // ---- smoke mode ------------------------------------------------------------
    bind_test_path       = ''        // small readable file on the project filesystem
    smoke_mem_hog_gb     = 3

    // ---- misc ---------------------------------------------------------------------
    help                 = false
    validate_only        = false     // validate inputs and stop
    publish_mode         = 'copy'
}

// Base resource classes, retry policy and resource caps
includeConfig 'conf/base.config'

process {
    container = { params.sif ?: params.image }
}

// Scheduler variables must cross the container boundary (containers start with `env -`)
env {
    PYTHONNOUSERSITE = '1'
    R_PROFILE_USER   = '/dev/null'
    R_ENVIRON_USER   = '/dev/null'
}

profiles {
    // ---------------- container engines ----------------
    apptainer   { includeConfig 'conf/containers/apptainer.config' }
    singularity { includeConfig 'conf/containers/singularity.config' }
    docker      { includeConfig 'conf/containers/docker.config' }
    dev         { includeConfig 'conf/containers/none.config' }

    // ---------------- schedulers ----------------
    lsf    { includeConfig 'conf/executors/lsf.config' }
    slurm  { includeConfig 'conf/executors/slurm.config' }
    pbspro { includeConfig 'conf/executors/pbspro.config' }
    pbs    { includeConfig 'conf/executors/pbs.config' }
    sge    { includeConfig 'conf/executors/sge.config' }
    local  { includeConfig 'conf/executors/local.config' }

    // ---------------- sites ----------------
    seadragon { includeConfig 'conf/sites/seadragon.config' }

    // ---------------- run types ----------------
    test  { includeConfig 'conf/test.config' }
    smoke { includeConfig 'conf/smoke.config' }
}

// Provenance reports are always written (one timestamped set per launch)
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyyMMdd_HHmmss')}.tsv"
    fields  = 'task_id,hash,native_id,name,status,exit,attempt,cpus,memory,time,realtime,peak_rss,queue,hostname,workdir'
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyyMMdd_HHmmss')}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyyMMdd_HHmmss')}.html"
}
