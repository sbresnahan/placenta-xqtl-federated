# Inputs for the two MDACC packaging scripts (MDACC only; sites never need this file).
#   scripts/make_public_reference_record.sh --env mdacc.env --out DIR [--dry-run]
#   scripts/make_restricted_bundle.sh       --env mdacc.env --out DIR [--dry-run]
# Copy this template to mdacc.env (ignored by git), fill in the paths, and check them with
# --dry-run, which lists every input with its size, or MISSING.

# ---- public reference record (Zenodo) -------------------------------------------------
MDACC_HPLR_GTF=/path/to/HPLRv2.0.annotated.gtf
MDACC_NORMALIZED_GTF=/path/to/HPLRv2.0.annotated.PANTRY.gtf
MDACC_CLASSIFICATION=/path/to/HPLRv2_classification.annotated.txt
MDACC_TXREVISE_DIR=/path/to/txrevise_dir
MDACC_MUSIC_RDS=/path/to/placenta_music_reference.rds
MDACC_GENOME_FASTA=/path/to/GRCh38_no_alt_analysis_set.fasta
# 1kGP high-coverage panel with chr:pos:ref:alt IDs
KGP_PFILE=/path/to/1kGP_high_coverage_pfile_prefix
KGP_SUPERPOP=/path/to/1kg_superpop.tsv
# PCA panel: biallelic autosomal SNPs, 1kGP MAF >= PANEL_MAF, then --indep-pairwise PANEL_PRUNE.
# Sites prune their own genotypes (--indep-pairwise 1000 100 0.1) and intersect with this panel.
PANEL_MAF=0.05
PANEL_PRUNE="1000 100 0.2"
# REDIportal editing sites (tables usable without restriction; docs/REFERENCES.md)
MDACC_REDIPORTAL_BED=/path/to/rediportal_hg38.bed
INCLUDE_REDIPORTAL=yes

# ---- restricted file (email only) -----------------------------------------------------
RESTRICTED_VERSION=1
ANCESTRIES="EAS EUR"
# Pooled, cross-cohort harmonized leafCutter counts per ancestry;
# {ANC} is replaced by each ancestry
MDACC_SPLICING_COUNTS="/path/to/{ANC}/leafcutter_harmonized_perind_numers.counts.gz"
# tensorQTL results ({ANC}_{MOD}_cisqtl.parquet and {ANC}_{MOD}_cisqtl_independent.parquet)
MDACC_QTL_RESULTS=/path/to/qtl_results_dir
QVALUE_MAX=0.05
# also take signals from the ungrouped scans ({ANC}_{MOD}_ungrouped_cisqtl*) when present
INCLUDE_UNGROUPED=no
