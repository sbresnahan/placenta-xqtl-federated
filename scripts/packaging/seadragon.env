# Inputs for the two MDACC packaging scripts on seadragon (atlas paths).
#   scripts/make_public_reference_record.sh --env scripts/packaging/seadragon.env --out DIR [--dry-run]
#   scripts/make_restricted_bundle.sh       --env scripts/packaging/seadragon.env --out DIR [--dry-run]
# Paths marked CHECK were not recorded in the atlas repository; confirm them before running
# (the --dry-run output lists every input with its size, or MISSING).

# ---- public reference record (Zenodo) -------------------------------------------------
ATLAS_HPLR_GTF=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/lrassembly_v2/HPLRv2/SQANTI3/HPLRv2.0.annotated.gtf
ATLAS_NORMALIZED_GTF=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/PANTRY/reference/HPLRv2.0.annotated.PANTRY.gtf
ATLAS_CLASSIFICATION=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/lrassembly_v2/HPLRv2/SQANTI3/HPLRv2_classification.annotated.txt
ATLAS_TXREVISE_DIR=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/PANTRY/reference/txrevise          # CHECK
ATLAS_MUSIC_RDS=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/PANTRY/reference/placenta_music_reference.rds   # CHECK
ATLAS_GENOME_FASTA=/rsrch5/home/epi/bhattacharya_lab/data/GenomicReferences/genome/GCA_000001405.15_GRCh38_no_alt_analysis_set_cleaned_ready_for_salmon.fasta
# 1kGP high-coverage panel with chr:pos:ref:alt IDs (atlas prep_QC_*.lsf 'kg_ref.standardized')
KGP_PFILE=/rsrch5/home/epi/stbresnahan/bhattacharya_lab/data/1kGP/kg_ref.standardized
KGP_SUPERPOP=/rsrch5/home/epi/stbresnahan/bhattacharya_lab/data/1kGP/1kg_superpop.tsv
# PCA panel: biallelic autosomal SNPs, 1kGP MAF >= PANEL_MAF, then --indep-pairwise PANEL_PRUNE.
# Sites prune their own genotypes at the atlas setting (1000 100 0.1) and intersect with this panel.
PANEL_MAF=0.05
PANEL_PRUNE="1000 100 0.2"
# REDIportal editing sites: include only after the redistribution terms are confirmed
ATLAS_REDIPORTAL_BED=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/PANTRY/reference/rediportal_hg38.bed
INCLUDE_REDIPORTAL=no

# ---- restricted file (email only) -----------------------------------------------------
RESTRICTED_VERSION=1
ANCESTRIES="EAS EUR"
# Pooled, cross-cohort harmonized leafCutter counts per ancestry (atlas step 17 output);
# {ANC} is replaced by each ancestry
ATLAS_SPLICING_COUNTS="/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/PANTRY/output/{ANC}/splicing/intermediate/leafcutter_harmonized_perind_numers.counts.gz"   # CHECK
# tensorQTL results ({ANC}_{MOD}_cisqtl.parquet and {ANC}_{MOD}_cisqtl_independent.parquet)
ATLAS_QTL_RESULTS=/rsrch9/home/epi/bhattacharya_lab/data/Placenta_QTL/PANTRY/output/qtl_results           # CHECK
QVALUE_MAX=0.05
# also take signals from the ungrouped scans ({ANC}_{MOD}_ungrouped_cisqtl*) when present
INCLUDE_UNGROUPED=no
