// -profile test : small fixtures for CI and local development (no real data).
// Combine with an engine: -profile test,docker (CI) or -profile test,dev (local env on PATH).
// --mode site runs on tests/fixtures/site: 1000 Genomes chr22 genotypes (130 samples) with
// synthetic phenotypes carrying the planted cis effects in tests/fixtures/site/TRUTH.tsv.
params {
    cohort_id      = 'TESTCOHORT'
    outdir         = 'results_test'
    max_cpus       = 2
    max_memory     = '6.GB'
    max_time       = '2.h'
    samplesheet    = "${projectDir}/tests/fixtures/site/samplesheet.csv"
    metadata       = "${projectDir}/tests/fixtures/site/metadata.tsv"
    restricted     = "${projectDir}/tests/fixtures/xqtl-restricted-test.tar.gz"
    site_refs      = "${projectDir}/tests/fixtures/site_refs"
    refs_dir       = "${projectDir}/tests/fixtures/refs_mini"
    phenotypes_dir = "${projectDir}/tests/fixtures/site/phenotypes"
    genotypes      = [raw: null, raw_build: 'GRCh38', source: 'wgs',
                      imputed_dir: "${projectDir}/tests/fixtures/site/genotypes", imputed_pattern: 'chr{chr}.dose.vcf.gz']
    rnaseq         = [read_layout: 'paired', strandedness: 'reverse', read_length: 100, library_type: 'total']
    mapping        = [modalities: ['expression', 'splicing'], hcp_grid: [0, 2, 5], nperm: 1000]
}
process {
    executor = 'local'
    // base.config resolved resourceLimits before this profile set params.max_*; cap again here
    resourceLimits = [cpus: 2, memory: 6.GB, time: 2.h]
}
executor {
    cpus   = 2
    memory = '6 GB'
}
