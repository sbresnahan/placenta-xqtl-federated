// -profile test : small fixtures for CI and local development (no real data).
// Combine with an engine: -profile test,docker (CI) or -profile test,dev (local env on PATH).
params {
    cohort_id   = 'TESTCOHORT'
    outdir      = 'results_test'
    max_cpus    = 2
    max_memory  = '6.GB'
    max_time    = '2.h'
    samplesheet = "${projectDir}/tests/fixtures/samplesheet.csv"
    metadata    = "${projectDir}/tests/fixtures/metadata.tsv"
    restricted  = "${projectDir}/tests/fixtures/xqtl-restricted-test.tar.gz"
    site_refs   = "${projectDir}/tests/fixtures/site_refs"
    genotypes   = [raw: null, raw_build: 'GRCh38', source: 'wgs',
                   imputed_dir: "${projectDir}/tests/fixtures/genotypes", imputed_pattern: 'chr{chr}.dose.vcf.gz']
    rnaseq      = [read_layout: 'paired', strandedness: 'reverse', read_length: 100, library_type: 'total']
}
process {
    executor = 'local'
}
executor {
    cpus   = 2
    memory = '6 GB'
}
