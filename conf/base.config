// conf/base.config -- resource classes shared by every site
//
// Processes declare a label (resource class), never a queue, scheduler flag or path.
// Sites tune classes in their profile (conf/sites/<site>.config) and cap them with
// --max_cpus / --max_memory / --max_time (process.resourceLimits).
// Memory and time grow with task.attempt, so a task killed for exceeding its memory
// limit is resubmitted with more (exit codes below; seadragon kills give 130).

process {
    cpus   = { 1 }
    memory = { 4.GB * task.attempt }
    time   = { 2.h * task.attempt }

    // Retry on scheduler kills (memory/time) and transient node failures; otherwise
    // let running tasks finish and stop.
    errorStrategy = { task.exitStatus in [104, 130, 134, 137, 139, 140, 143, 247, 271] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration
    ]

    // Queue/partition: --queue forces one; --queue_rules picks the first queue whose
    // walltime limit covers the task (e.g. 'short:3h,medium:24h,long:120h').
    queue = {
        if (params.queue) return params.queue
        if (!params.queue_rules) return null
        def rules = params.queue_rules.toString().tokenize(',').collect { r -> r.trim().tokenize(':') }
        def hit = rules.find { r -> task.time <= nextflow.util.Duration.of(r[1]) }
        return hit ? hit[0] : rules[-1][0]
    }
    clusterOptions = { params.cluster_options ?: null }

    withLabel: 'process_single' {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = { 2 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 16 }
        memory = { 64.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withLabel: 'process_long' {
        time   = { 48.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        memory = { 128.GB * task.attempt }
    }
    // tensorQTL steps: CPU by default; with --use_gpu they go to the GPU queue
    withLabel: 'process_gpu_capable' {
        cpus   = { params.use_gpu ? 4 : 8 }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
        queue  = {
            if (params.use_gpu && params.gpu_queue) return params.gpu_queue
            if (params.queue) return params.queue
            if (!params.queue_rules) return null
            def rules = params.queue_rules.toString().tokenize(',').collect { r -> r.trim().tokenize(':') }
            def hit = rules.find { r -> task.time <= nextflow.util.Duration.of(r[1]) }
            return hit ? hit[0] : rules[-1][0]
        }
        clusterOptions = { [params.cluster_options, (params.use_gpu ? params.gpu_cluster_options : '')].findAll { o -> o }.join(' ') ?: null }
        containerOptions = { (params.use_gpu && workflow.containerEngine in ['singularity', 'apptainer']) ? '--nv' : '' }
    }
    withLabel: 'process_gpu' {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
        queue  = { params.gpu_queue ?: params.queue }
        clusterOptions = { [params.cluster_options, params.gpu_cluster_options].findAll { o -> o }.join(' ') ?: null }
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '' }
    }
    // Many short identical tasks (per chromosome / chunk) are submitted as job arrays.
    // --job_array_size 0 turns arrays off for sites that do not allow them.
    withLabel: 'process_array' {
        array = params.job_array_size as int
    }
    // Light bookkeeping steps run where the head runs when the executor allows it
    withLabel: 'process_local' {
        cpus   = { 1 }
        memory = { 2.GB }
        time   = { 1.h }
    }
}
