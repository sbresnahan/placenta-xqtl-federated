// Sun/Univa/Son of Grid Engine. Multi-core jobs need a parallel environment; set
// --sge_penv to your site's name (qconf -spl), default 'smp'.
process.executor = 'sge'
process.penv     = 'smp'
executor {
    name            = 'sge'
    queueSize       = params.queue_size
    submitRateLimit = params.submit_rate_limit
    pollInterval    = '30 sec'
}
