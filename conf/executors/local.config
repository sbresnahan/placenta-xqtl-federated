// No scheduler: every task runs on the machine running Nextflow. Set --max_cpus and
// --max_memory to the node size; Nextflow then never runs more than fits.
process.executor = 'local'
executor {
    name   = 'local'
    cpus   = params.max_cpus as int
    memory = params.max_memory as nextflow.util.MemoryUnit
}
