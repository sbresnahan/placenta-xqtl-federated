// IBM Spectrum LSF
process.executor = 'lsf'
executor {
    name            = 'lsf'
    perJobMemLimit  = params.lsf_per_job_mem   // -M / rusage[mem] given per job (not per slot)
    queueSize       = params.queue_size
    submitRateLimit = params.submit_rate_limit
    pollInterval    = '30 sec'
    queueStatInterval = '2 min'
}
