// TEMPLATE for a Slurm site. Copy to conf/sites/<yoursite>.config, edit the values
// marked EDIT, and run with
//   ./run_xqtl.sh -profile slurm,apptainer -c conf/sites/<yoursite>.config -params-file cohort.yml --mode site
// Check partitions and limits with:  sinfo -s ; scontrol show partition <name>

params {
    // EDIT: partitions in increasing walltime order, each with its maximum walltime.
    queue_rules          = 'short:4h,normal:48h,long:168h'
    // EDIT: GPU partition and request syntax (only needed with --use_gpu).
    gpu_queue            = 'gpu'
    gpu_cluster_options  = '--gres=gpu:1'
    // EDIT: account/QOS flags required on every job, if any.
    cluster_options      = ''            // e.g. '--account=myproj --qos=normal'
    // EDIT: filesystems that hold inputs, work dir and outputs.
    bind_paths           = '/scratch,/project'
    // EDIT: largest node you may use.
    max_cpus             = 32
    max_memory           = '256.GB'
    max_time             = '168.h'
}

// Uncomment if your site requires memory per CPU instead of per job:
// process.clusterOptions = { "--mem-per-cpu=${(task.memory.toMega() / task.cpus) as int}M ${params.cluster_options}" }
