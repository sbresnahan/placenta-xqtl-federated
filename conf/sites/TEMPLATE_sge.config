// TEMPLATE for a Grid Engine (SGE/UGE/SoGE) site. Copy to conf/sites/<yoursite>.config,
// edit, run with  -profile sge,apptainer -c conf/sites/<yoursite>.config
// Check queues and parallel environments with:  qconf -sql ; qconf -spl

params {
    queue_rules          = 'short.q:4h,all.q:48h,long.q:168h'  // EDIT
    cluster_options      = ''                                // EDIT e.g. '-P myproject'
    bind_paths           = '/scratch,/project'               // EDIT
    max_cpus             = 32
    max_memory           = '256.GB'
    max_time             = '168.h'
}
process {
    penv = 'smp'                      // EDIT: parallel environment for multi-core jobs
    // Grid Engine memory (h_vmem) is usually per slot: divide the request by cpus.
    clusterOptions = { "-l h_vmem=${(task.memory.toMega() / task.cpus) as int}M ${params.cluster_options}".trim() }
}
