// TEMPLATE for a PBS Pro / OpenPBS site. Copy to conf/sites/<yoursite>.config, edit,
// run with  -profile pbspro,apptainer -c conf/sites/<yoursite>.config
// (Torque/legacy PBS: use -profile pbs instead.) Check queues with:  qstat -Qf

params {
    queue_rules          = 'short:4h,workq:48h,long:168h'    // EDIT
    gpu_queue            = 'gpu'                             // EDIT
    gpu_cluster_options  = '-l select=1:ngpus=1'             // EDIT
    cluster_options      = ''                                // EDIT e.g. '-A myproject'
    bind_paths           = '/scratch,/project'               // EDIT
    max_cpus             = 32
    max_memory           = '256.GB'
    max_time             = '168.h'
}
