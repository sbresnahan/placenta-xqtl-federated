// MD Anderson seadragon: IBM LSF + Apptainer 1.5 (invoked as `singularity`)
// Every value below was confirmed by the seadragon cluster checks (2026-10-29; LSF jobs
// 79979021 and 79979246; docs/TESTING.md); see docs/HPC.md "Seadragon (worked example)".
//
//   ./run_xqtl.sh -profile seadragon -params-file cohort.yml --mode site
//
// - Queues are chosen from each task's walltime. seadragon's esub rejects walltimes
//   outside the queue range: short <= 3 h, medium > 3 h and < 24 h, long 24-120 h.
// - Memory requests are per job; LSF_UNIT_FOR_LIMITS=GB and LSB_MEMLIMIT_ENFORCE=y,
//   so tasks over their request are killed (exit 130) and retried with more memory.
// - LSB_RESOURCE_ENFORCE="cpu gpu": a task only sees the cores it requested.
// - Compute nodes have no internet; the image and references are local files.

includeConfig '../executors/lsf.config'
includeConfig '../containers/singularity.config'

params {
    queue_rules          = 'short:3h,medium:23h59m,long:120h'
    gpu_queue            = 'gpu'
    gpu_cluster_options  = '-gpu num=1'
    bind_paths           = '/rsrch5,/rsrch9'
    lsf_per_job_mem      = true
    // Largest node size commonly available on seadragon (16 cores, 120 GB). Raise only
    // after checking node sizes with `bhosts -l` / `lshosts`.
    max_cpus             = 16
    max_memory           = '120.GB'
    max_time             = '120.h'
    queue_size           = 200
}

executor {
    perJobMemLimit = true
    queueSize      = 200
}

// The container and executor profiles are read before this file sets the params above, so
// the settings derived from them are set again here (bind paths and resource caps).
process.resourceLimits = [cpus  : params.max_cpus as int,
                          memory: params.max_memory as nextflow.util.MemoryUnit,
                          time  : params.max_time as nextflow.util.Duration]
apptainer.runOptions   = params.bind_paths ? params.bind_paths.toString().tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
singularity.runOptions = params.bind_paths ? params.bind_paths.toString().tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
