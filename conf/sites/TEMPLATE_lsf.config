// TEMPLATE for an LSF site. Copy to conf/sites/<yoursite>.config, edit EDIT values,
// run with  -profile lsf,apptainer -c conf/sites/<yoursite>.config
// Check queues and limits with:  bqueues -l <queue> ; lsadmin showconf lim | grep LSF_UNIT_FOR_LIMITS

params {
    queue_rules          = 'short:4h,normal:48h,long:168h'   // EDIT
    gpu_queue            = 'gpu'                             // EDIT
    gpu_cluster_options  = '-gpu num=1'                      // EDIT (older LSF: '-R "rusage[ngpus_physical=1]"')
    cluster_options      = ''                                // EDIT e.g. '-P myproject'
    bind_paths           = '/scratch,/project'               // EDIT
    // EDIT: true if -M / rusage[mem] are per job (LSB_JOB_MEMLIMIT=Y or
    // RESOURCE_RESERVE_PER_TASK=N); false if per slot.
    lsf_per_job_mem      = true
    max_cpus             = 32
    max_memory           = '256.GB'
    max_time             = '168.h'
}

// The container and executor profiles are read before this file sets the params above, so
// the settings derived from them are set again here (bind paths and resource caps).
process.resourceLimits = [cpus  : params.max_cpus as int,
                          memory: params.max_memory as nextflow.util.MemoryUnit,
                          time  : params.max_time as nextflow.util.Duration]
apptainer.runOptions   = params.bind_paths ? params.bind_paths.toString().tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
singularity.runOptions = params.bind_paths ? params.bind_paths.toString().tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
executor.perJobMemLimit = params.lsf_per_job_mem
