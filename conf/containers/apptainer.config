// Apptainer (also works where `singularity` is a symlink to Apptainer >= 1.0)
apptainer {
    enabled      = true
    autoMounts   = true
    runOptions   = params.bind_paths ? params.bind_paths.toString().tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
    envWhitelist = 'LSB_JOBID,LSB_JOBINDEX,LSB_DJOB_NUMPROC,LSB_MAX_NUM_PROCESSORS,SLURM_JOB_ID,SLURM_ARRAY_TASK_ID,SLURM_CPUS_PER_TASK,PBS_JOBID,PBS_ARRAY_INDEX,JOB_ID,SGE_TASK_ID,NSLOTS'
}
singularity.enabled = false
docker.enabled      = false
