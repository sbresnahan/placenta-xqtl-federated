// -profile test_phenotyping : chr22 phenotyping fixture (tests/scripts/test_phenotyping.sh).
// Eight public SNUH placenta RNA-seq runs (PRJNA820329) cut to chr22 read pairs, the GENCODE v45
// chr22 stand-in annotation and txrevise events in tests/fixtures/refs_chr22, and a restricted
// test file whose frozen splicing clusters were derived from these samples. The chr22 genome
// (--genome_fasta) and --site_refs are supplied by the test script.
// Use with an engine: -profile test_phenotyping,docker or -profile test_phenotyping,dev
params {
    cohort_id             = 'SNUHCHR22'
    outdir                = 'results_test_phenotyping'
    max_cpus              = 2
    max_memory            = '6.GB'
    max_time              = '2.h'
    samplesheet           = "${projectDir}/tests/fixtures/phenotyping/samplesheet.csv"
    metadata              = "${projectDir}/tests/fixtures/phenotyping/metadata.tsv"
    restricted            = "${projectDir}/tests/fixtures/phenotyping/xqtl-restricted-phenotyping-test.tar.gz"
    refs_dir              = "${projectDir}/tests/fixtures/refs_chr22"
    annotation_gtf        = "${projectDir}/tests/fixtures/refs_chr22/annotation/gencode.v45.chr22.PANTRY.gtf.gz"
    phenotypes_dir        = null
    star_sa_index_nbases  = 11
    normalize_min_samples = 4
    rnaseq                = [read_layout: 'paired', strandedness: 'reverse', read_length: 101, library_type: 'total']
}
process {
    executor = 'local'
    resourceLimits = [cpus: 2, memory: 6.GB, time: 2.h]
}
executor {
    cpus   = 2
    memory = '6 GB'
}
// IRFinder-S refuses to build a reference on hosts with < 32 GB RAM (patched gate; chr22 needs ~1 GB)
env {
    IRFINDER_MIN_RAM_MB = '4000'
}
